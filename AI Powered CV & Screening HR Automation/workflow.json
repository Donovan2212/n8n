    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let text = item.json.text || '';\n  \n  // Verwijder eventuele thinking-tags (voor de zekerheid)\n  text = text.replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\n  item.json.aiOutput = text;\n  \n  // Probeer de match-score eruit te halen (zoekt naar patronen zoals \"score: 75\" of \"75/100\" of \"75 uit 100\")\n  const scoreMatch = text.match(/(\\d{1,3})\\s*(?:\\/100|uit de 100|\\/\\s*100)|score[:\\s]*(\\d{1,3})/i);\n  const score = scoreMatch ? parseInt(scoreMatch[1] || scoreMatch[2]) : null;\n  \n  item.json.matchScore = score;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "28e4a5d5-7970-4192-8b45-fd7bd6f2db7e",
      "name": "text change"
    },
