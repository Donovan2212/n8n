{
  "name": "P3 AI Research & Knowledge Automation System",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const data = item.json.body;\n\n  const errors = [];\n\n  // topic\n  if (!data.topic || typeof data.topic !== 'string' || data.topic.trim() === '') {\n    errors.push('topic is required and must be a non-empty string');\n  }\n\n  // research_depth\n  const allowedDepths = ['basic', 'standard', 'deep'];\n\n  if (!allowedDepths.includes(data.research_depth)) {\n    errors.push('research_depth must be basic, standard or deep');\n  }\n\n  // max_sources\n  if (\n    typeof data.max_sources !== 'number' ||\n    !Number.isInteger(data.max_sources) ||\n    data.max_sources < 1 ||\n    data.max_sources > 20\n  ) {\n    errors.push('max_sources must be an integer between 1 and 20');\n  }\n\n  item.json.validation = {\n    valid: errors.length === 0,\n    errors: errors\n  };\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "5776beaa-21dd-4b0e-a868-484621a57b48",
      "name": "Input Validation"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const data = item.json.body;\n\n  item.json.body = {\n    topic: data.topic.trim(),\n    research_depth: data.research_depth.toLowerCase().trim(),\n    max_sources: Number(data.max_sources)\n  };\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "f05ab77b-a594-45a4-8152-8b0a6ba91323",
      "name": "Normalize Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a research planning agent.\n\nAnalyze this research request:\n\nTopic: {{ $json.body.topic }}\nResearch depth: {{ $json.body.research_depth }}\nMaximum sources: {{ $json.body.max_sources }}\n\nCreate a research plan for this exact topic.\n\nDetermine:\n1. The main research question.\n2. The subtopics that should be investigated.\n3. The types of sources that would be useful.\n4. The target number of sources.\n\nReturn ONLY valid JSON:\n\n{\n  \"research_question\": \"string\",\n  \"subtopics\": [\"string\"],\n  \"source_types\": [\"string\"],\n  \"target_sources\": 5\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        0
      ],
      "id": "2bd3ae44-d07a-4b99-afaf-2f3920dabf73",
      "name": "AI Research Agent"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const rawOutput = item.json.output;\n\n  try {\n    const researchPlan = JSON.parse(rawOutput);\n\n    item.json.research_plan = researchPlan;\n\n  } catch (error) {\n    throw new Error('AI Agent returned invalid JSON: ' + error.message);\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "e8429c0b-b8d6-4d7f-ab5f-7b3565d0fbad",
      "name": "Parse Research Plan"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"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\",\n  \"query\": \"{{ $json.research_plan.research_question }}\",\n  \"search_depth\": \"advanced\",\n  \"max_results\": \"{{ $json.research_plan.target_sources }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        80,
        400
      ],
      "id": "e40b8e01-f28c-4fb3-88a9-fee410584124",
      "name": "Tavily Research API",
      "credentials": {
        "httpHeaderAuth": {
          "id": "jhMytELXslTDL3S8",
          "name": "Travily"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  if (!data.results || !Array.isArray(data.results)) {\n    throw new Error('Tavily API returned no valid results array');\n  }\n\n  if (data.results.length === 0) {\n    throw new Error('Tavily API returned zero research results');\n  }\n\n  for (const result of data.results) {\n    output.push({\n      json: {\n        content: result.content || '',\n        url: result.url || '',\n        title: result.title || '',\n        score: result.score || 0,\n        topic: data.query || '',\n        api_validation: {\n          valid: true,\n          result_count: data.results.length\n        }\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        400
      ],
      "id": "27d77d90-74ba-4a90-8296-a2e250a2f0e5",
      "name": "API Response Validation"
    },
    {
      "parameters": {
        "jsCode": "const source = $('API Response Validation').first().json;\n\nconst query = source.topic || source.query || '';\n\nif (!query) {\n  throw new Error('No research query found');\n}\n\nreturn [\n  {\n    json: {\n      query: query,\n      retrieval_query: query\n    }\n  }\n];"
      },
