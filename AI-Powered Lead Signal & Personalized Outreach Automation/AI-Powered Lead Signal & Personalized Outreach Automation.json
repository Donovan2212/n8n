      "id": "163fcb89-ee0c-4caa-8afb-6c0e0715cf79",
      "name": "Receive Lead",
      "webhookId": "3c136f46-9d71-442d-aee5-fce0de5773a5"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.text;\n\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\n\nif (start === -1 || end === -1) {\n  throw new Error('Geen JSON gevonden in text');\n}\n\nconst jsonText = text.substring(start, end + 1);\nconst result = JSON.parse(jsonText);\n\nreturn {\n  json: {\n    name: $('Receive Lead').item.json.body.name,\n    company: $('Receive Lead').item.json.body.company,\n    role: $('Receive Lead').item.json.body.role,\n    interest: $('Receive Lead').item.json.body.interest,\n    source: $('Receive Lead').item.json.body.source,\n\n    lead_score: Number(result.lead_score),\n    temperature: result.temperature,\n    intent: result.intent,\n    reason: result.reason\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        144
      ],
      "id": "1302e4aa-4b10-4ed3-9040-795f399fbb43",
      "name": "Progress AI Result"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a B2B growth marketing assistant.\n\nCreate a short, professional and personalized outreach message for this qualified lead.\n\nDo not invent information.\nUse only the lead information provided below.\n\nThe message should:\n- mention the person's role or company naturally\n- reference their interest in AI automation\n- be helpful rather than overly sales-focused\n- have a clear but low-pressure call to action\n- be suitable for email or LinkedIn\n- maximum 100 words\n\nLead:\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nRole: {{ $json.role }}\nInterest: {{ $json.interest }}\nSource: {{ $json.source }}\n\nLead score: {{ $json.lead_score }}\nTemperature: {{ $json.temperature }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1024,
        96
      ],
      "id": "5ae70c66-6325-481e-abaf-c37c6fe61fe1",
