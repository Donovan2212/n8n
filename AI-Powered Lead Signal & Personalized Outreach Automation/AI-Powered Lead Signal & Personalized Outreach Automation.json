    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the lead below.\n\nReturn ONLY this JSON object. Nothing else.\n\n{\n  \"lead_score\": 85,\n  \"temperature\": \"HOT\",\n  \"intent\": \"high\",\n  \"reason\": \"Short explanation\"\n}\n\nReplace the example values with your analysis.\n\nLead:\nName: {{ $json.body.name }}\nCompany: {{ $json.body.company }}\nRole: {{ $json.body.role }}\nInterest: {{ $json.body.interest }}\nSource: {{ $json.body.source }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        96
      ],
      "id": "1377f5fc-08d9-4b8a-99d1-083ba3a4405f",
      "name": "AI Lead Analysis"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
